# Copy to .env and fill in values supplied by the owner. Never commit .env (FR-048).
# Placeholders only. No real credentials, numbers, regions, or keys belong in this file.

SALESAGENT_ENV=development
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (deploy/docker-compose.yml service `db`)
SALESAGENT_DB_NAME=salesagent
SALESAGENT_DB_USER=salesagent
SALESAGENT_DB_PASSWORD=replace-with-a-database-password
SALESAGENT_DB_HOST=localhost
SALESAGENT_DB_PORT=5432

# Keyed hashing of identifiers in logs and allowlists (R-018)
SALESAGENT_LOG_HMAC_KEY=replace-with-a-random-hmac-key

# WhatsApp Cloud API (R-004). Values come from the Meta app dashboard.
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_VERIFY_TOKEN=replace-with-webhook-verify-token
WHATSAPP_ACCESS_TOKEN=replace-with-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_GRAPH_API_VERSION=replace-with-graph-api-version
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com

# M0 technical connectivity mode (plan M0). Off in production.
WHATSAPP_M0_MODE=false
# Comma-separated HMAC hashes of synthetic test numbers, computed with SALESAGENT_LOG_HMAC_KEY.
WHATSAPP_TEST_RECIPIENT_HMACS=
WHATSAPP_M0_RESPONSE_TEXT=Connectivity test OK
